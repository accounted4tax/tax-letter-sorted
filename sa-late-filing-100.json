{
  "id": "sa-late-filing-100",
  "version": "0.2",
  "status": "agreed with Eduard 25 Oct 2026; recognition confirmed from real letters 28 Oct 2026",
  "title_key": "letters.sa_late_filing_100.title",
  "tax": "self_assessment",
  "penalty_type": "late_filing_initial",
  "applies_to_tax_years": {
    "up_to": "2025-26",
    "note": "From 2026-27, clients in Making Tax Digital for Income Tax may come under the points-based late submission regime instead. Separate rule to be added."
  },
  "recognition": {
    "form_codes": [
      "SA326D"
    ],
    "heading_phrases": [
      "We didn't receive your tax return on time",
      "Self Assessment: Late tax return",
      "Notice of penalty assessment"
    ],
    "amount": 100,
    "not_this_letter_if": [
      "the letter is about paying tax late (late payment penalty)",
      "the amount is not 100 (daily, 6-month or 12-month penalty: separate rules)",
      "the form code is SA370 (later late filing or late payment penalties: separate rules)"
    ],
    "form_code_versions_seen": [
      "SA326D HMRC 01/26"
    ],
    "source": "Confirmed from real HMRC letters supplied by Eduard, 28 Oct 2026"
  },
  "fields_to_read": [
    "notice_date",
    "tax_year",
    "penalty_amount",
    "utr",
    "name",
    "address"
  ],
  "facts_for_explanation": {
    "what_it_is": "A fixed £100 penalty because the tax return for the tax year arrived after the deadline, or has not been sent at all. It applies even if no tax is owed or the tax was paid on time.",
    "if_nothing_done": [
      "After 3 months: £10 a day, up to £900",
      "After 6 months: a further 5% of the tax due or £300, whichever is greater",
      "After 12 months: another 5% or £300, whichever is greater"
    ],
    "filing_deadline_online": "31 January after the end of the tax year"
  },
  "deadlines": {
    "appeal_days_from_notice": 30,
    "pay_days_from_notice": 30,
    "no_payment_while_appeal_open": true,
    "late_appeal": {
      "allowed": true,
      "route": "normal",
      "extra_question": "q_why_late"
    },
    "extended_appeal_date_on_letter": {
      "rule": "If page 2 of the notice says 'We've given you more time to appeal your penalty. You now have until [date]', use that date as the appeal deadline instead of notice date + 30 days.",
      "phrase": "We've given you more time to appeal your penalty",
      "source": "Confirmed from real HMRC letters supplied by Eduard, 28 Oct 2026"
    }
  },
  "preconditions": [
    {
